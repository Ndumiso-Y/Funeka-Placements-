# Frontend-safe Vite variables for the future Supabase client.
# Put real local values in .env.local, not in this file.
# Add production values in Vercel Environment Variables.
# Never commit .env.local.
# Never place a Supabase service role key in frontend code.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
